# ─────────────────────────────────────────────────────────────
# NextNTech.org — environment variables (names only, no real values)
#
# Local:      cp .env.example .env   and fill in the values below.
# Hosting:    set these in cPanel → your Node.js app → Environment variables.
# Codespaces: nothing to do — .devcontainer/docker-compose.yml sets them.
#
# NEVER commit a real .env file or real credentials. This repo is public.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (SECRET).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Local Docker (docker compose up -d) uses the throwaway dev values from docker-compose.yml:
#   postgresql://nextntech:nextntech@localhost:5432/nextntech?schema=public
# Staging and production each use their OWN database and a strong generated password.
DATABASE_URL=

# Public base URL of this copy of the site (not secret).
# Local: http://localhost:3000 · Staging: https://stage.nextntech.org · Production: https://nextntech.org
# Baked in at build time — rebuild after changing it.
NEXT_PUBLIC_SITE_URL=

# ── Added in later build phases (leave empty until then) ──
# Phase 3 — accounts (Auth.js) and email:
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
RESEND_API_KEY=
# Phase 4 — certificate file storage:
BLOB_READ_WRITE_TOKEN=
