# ─────────────────────────────────────────────────────────────
# NextNTech.org — environment variables
# Copy to .env (Prisma CLI) and .env.local (Next.js): cp .env.example .env
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local (docker compose up -d): matches docker-compose.yml
# Hosted: your Neon or Supabase connection string (use the pooled URL on Vercel).
DATABASE_URL="postgresql://nextntech:nextntech@localhost:5432/nextntech?schema=public"

# Public base URL of the site (used for share links, certificates, OAuth redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Added in later phases ──
# Phase 3 (Auth.js): AUTH_SECRET, AUTH_GOOGLE_ID/SECRET, AUTH_FACEBOOK_ID/SECRET,
#   AUTH_LINKEDIN_ID/SECRET, AUTH_MICROSOFT_ENTRA_ID_ID/SECRET/ISSUER, RESEND_API_KEY
# Phase 4 (certificates storage): BLOB_READ_WRITE_TOKEN (or Supabase storage keys)
# Phase 6 (analytics, optional, cookieless): NEXT_PUBLIC_ANALYTICS_*
